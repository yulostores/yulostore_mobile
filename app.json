{
  "expo": {
    "name": "Yulo Stores",
    "slug": "Customer-Portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "yulostores",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.yulostores.customer",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Yulo Stores uses your camera to scan QR codes for quick ordering.",
        "NSMicrophoneUsageDescription": "Yulo Stores uses your microphone for voice search.",
        "NSSpeechRecognitionUsageDescription": "Yulo Stores uses speech recognition to turn what you say into a search."
      }
    },
    "android": {
      "package": "com.yulostores.customer",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF0E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF5E00"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yulo Stores uses your location to show restaurants that deliver to you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yulo Stores uses your camera to scan QR codes for quick ordering.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Yulo Stores uses your microphone for voice search.",
          "speechRecognitionPermission": "Yulo Stores uses speech recognition to turn what you say into a search."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cfb8e587-7e59-4876-9659-d615f421d59e"
      }
    }
  }
}
