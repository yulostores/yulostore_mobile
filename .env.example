# Copy to .env.local (gitignored) to override anything below for your machine.
# Expo loads .env files automatically; only EXPO_PUBLIC_-prefixed vars are
# inlined into the bundle and readable from app code.

# ── API ────────────────────────────────────────────────────────────────────
# Usually leave this unset. In development the app derives the API host from
# the Metro bundle URL (src/api/config.js), so a phone on the same Wi-Fi finds
# your laptop without anyone editing an IP after every DHCP lease. Set it only
# to point a local run at a deployed server.
# EXPO_PUBLIC_API_BASE=https://staging.yulostores.com

# ── Feature flags ──────────────────────────────────────────────────────────
# Accepted values: on/off, true/false, 1/0, yes/no. Unset means "use the
# default", which is on wherever the underlying module is actually available.
#
# Setting one here LOCKS it for the whole bundle — the dev flag panel
# (Profile → Settings → Feature flags) shows it as LOCKED and cannot change it.
# For day-to-day flipping while testing, use the panel instead of this file;
# these exist for build profiles and CI, where there is nobody to tap a switch.
#
# Registry and descriptions: src/lib/features.js

# Mic on the search screen and menu index sheet.
# Requires expo-speech-recognition, which is NOT in Expo Go — it resolves to
# unavailable there whatever this says.
# EXPO_PUBLIC_FEATURE_VOICE_SEARCH=off

# Camera QR scanner. Off falls back to typing the code by hand, which is the
# only way to exercise the scan flow on an emulator.
# EXPO_PUBLIC_FEATURE_QR_SCANNER=off

# "Use my current location" on the address screen. Typing an address always works.
# EXPO_PUBLIC_FEATURE_DEVICE_LOCATION=off

# Frosted backdrop behind the sticky cart / active order bars. Turn off first
# when a cheap handset scrolls badly.
# EXPO_PUBLIC_FEATURE_BLUR_EFFECTS=off

# Socket.io partner position and ETA. Turn off when the server you are pointed
# at only speaks REST, or the tracking screen retries the handshake forever.
# EXPO_PUBLIC_FEATURE_LIVE_TRACKING=off
