{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://10.0.2.2:3000"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "lan": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://192.168.0.16:3000"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "lan"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://staging.yulostores.com"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "cloud": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://yulo-backend-f4juo.ondigitalocean.app",
        "EXPO_PUBLIC_FEATURE_LIVE_TRACKING": "off"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "cloud"
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "production-apk"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.yulostores.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
